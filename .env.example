# AI Quant Terminal — local environment configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored and must never
# be committed (deployment.md §3).

# ---------- PostgreSQL ----------
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant_local_dev_password
POSTGRES_DB=quant
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full DSN used by the Go API and the Python quant-mcp service.
DATABASE_URL=postgres://quant:quant_local_dev_password@db:5432/quant?sslmode=disable

# ---------- Service ports (host-side) ----------
WEB_PORT=3000
API_PORT=8080
QUANT_MCP_PORT=8000
OLLAMA_PORT=11434

# ---------- Service wiring ----------
# Base URL the Go API uses to reach the Python quant-mcp service (HTTP/JSON,
# planning.md §4 decision 1).
QUANT_MCP_URL=http://quant-mcp:8000
# Base URL the Next.js app uses to reach the Go API (browser-visible).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---------- LLM provider ----------
# `gemini` (default, free tier) or `ollama` (local fallback, requires
# `docker compose --profile local-llm up`).
LLM_PROVIDER=gemini
# Required only when LLM_PROVIDER=gemini. quant-mcp fails loudly at startup if
# this is unset while LLM_PROVIDER=gemini (NFR5.6). Placeholder only — put the
# real key in .env, never here.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
# Used only when LLM_PROVIDER=ollama.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ---------- Logging ----------
LOG_LEVEL=info
